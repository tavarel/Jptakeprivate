# Copy this file to `.env` and fill in your keys. `.env` is gitignored — never commit it.

# EDINET API v2 key (free): register at https://api.edinet-fsa.go.jp/ (see EDINET API spec)
RADAR_EDINET_API_KEY=

# J-Quants API V2 key (free plan available): issue it from the J-Quants dashboard
RADAR_JQUANTS_API_KEY=

# Optional overrides
# RADAR_DATA_DIR=data
# RADAR_REQUESTS_PER_SECOND=0.5
